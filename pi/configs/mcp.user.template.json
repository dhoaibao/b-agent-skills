{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "requestTimeoutMs": 30000,
    "directTools": false
  },
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ],
      "env": {},
      "lifecycle": "lazy"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "lifecycle": "lazy"
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      },
      "lifecycle": "lazy"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp/readonly",
      "auth": "oauth",
      "oauth": {
        "scope": "read"
      },
      "includeTools": ["get_issue"],
      "lifecycle": "lazy"
    },
    "mobbin": {
      "url": "https://api.mobbin.com/mcp",
      "auth": "oauth",
      "includeTools": ["mobbin_search_screens", "mobbin_search_flows", "mobbin_search_sections"],
      "lifecycle": "lazy"
    },
    "brave-search": {
      "command": "bunx",
      "args": ["@brave/brave-search-mcp-server", "--transport", "stdio"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "lifecycle": "lazy"
    },
    "firecrawl": {
      "command": "bunx",
      "args": ["firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "lifecycle": "lazy"
    },
    "playwright": {
      "command": "bunx",
      "args": ["@playwright/mcp", "--isolated"],
      "env": {},
      "lifecycle": "lazy"
    }
  }
}
