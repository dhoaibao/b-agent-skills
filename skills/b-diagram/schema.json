{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b-agentic.dev/schemas/diagram-v1.json",
  "title": "b-diagram source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "title", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "kind": {
      "enum": ["architecture", "workflow", "sequence", "data-flow", "lifecycle"]
    },
    "title": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "location"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
  }
}
