{
  "name": "@dhoaibao/preview-markdown",
  "version": "0.1.0",
  "description": "Inline Markdown preview cards for Pi with theme switching and source copying.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "markdown",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dhoaibao/b-agentic.git"
  },
  "homepage": "https://github.com/dhoaibao/b-agentic",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.preview-markdown.md",
    "pi/extensions/b-agentic-preview-markdown.ts"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions/b-agentic-preview-markdown.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "package:check": "bash pi/scripts/validate-preview-markdown-package.sh"
  }
}
